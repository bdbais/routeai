// routeai.bais.info: static showcase + the community statistics endpoints.
// Build first: node build.mjs      Deploy: npx wrangler deploy   (from this folder)
//
// The worker only handles /api/* and the Community page; everything else is served straight
// from ./dist by the assets runtime, with the headers in dist/_headers.
{
  "name": "routeai-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/community", "/community/*", "/*/community", "/*/community/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "routeai-community",
      "database_id": "PLACEHOLDER-SET-BY-WRANGLER-D1-CREATE",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "routeai.bais.info", "custom_domain": true }]
}
